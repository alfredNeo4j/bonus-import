UNWIND [
  {id: "ev-01-shared", text: "A visitor with no engineering background read the poster alone, then explained the project back correctly and without help.", source: "Poster viewing", location: "Visitor trial", capturedAt: "2026-05-11T11:00:00Z"},
  {id: "ev-01-physical", text: "The soil moisture monitor prototype sits in a finished enclosure with hidden wiring, a labelled control panel and a companion web page.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-11T12:00:00Z"},
  {id: "ev-01-success", text: "The soil moisture monitor device ran the same test five times with matching results, and the team added a second use that was not in the brief.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-11T13:00:00Z"},
  {id: "ev-01-value", text: "The team explained how the soil moisture monitor idea differs from two existing products and why it helps its users.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-11T14:00:00Z"},
  {id: "ev-01-spelling", text: "A proofread of the soil moisture monitor poster found no spelling or grammar mistakes.", source: "Poster", location: "Proofread", capturedAt: "2026-05-11T16:00:00Z"},
  {id: "ev-02-design", text: "The rainwater filter poster is well laid out and the diagrams support the text, with one crowded panel. Most visitors followed it on their own.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-12T11:00:00Z"},
  {id: "ev-02-physical", text: "The rainwater filter prototype works and has a neat enclosure, an easy control and one extra feature, a status light.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-12T12:00:00Z"},
  {id: "ev-02-success", text: "The rainwater filter device gave matching results over several runs, and the approach was new to the class.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-12T13:00:00Z"},
  {id: "ev-02-value", text: "The team named the people who would use the rainwater filter idea, explained why current products fall short, and listed next steps for testing and a larger build.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-12T14:00:00Z"},
  {id: "ev-02-comm", text: "The presenter spoke clearly about the rainwater filter project, used the poster well and answered most questions.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-12T15:00:00Z"},
  {id: "ev-02-spelling", text: "A proofread of the rainwater filter poster found several mistakes that a reader would notice.", source: "Poster", location: "Proofread", capturedAt: "2026-05-12T16:00:00Z"},
  {id: "ev-03-design", text: "The ramp load sensor poster has a sensible structure, but two panels are crowded and pale text on a light background is hard to read. Visitors asked the presenter to explain the flow.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-13T11:00:00Z"},
  {id: "ev-03-physical", text: "The ramp load sensor prototype works and has a neat enclosure, an easy control and one extra feature, a status light.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-13T12:00:00Z"},
  {id: "ev-03-success", text: "The ramp load sensor device met the project goals and gave similar results in three runs.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-13T13:00:00Z"},
  {id: "ev-03-value", text: "The team described who needs the ramp load sensor idea, named existing products, and said how a later version could fill a gap.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-13T14:00:00Z"},
  {id: "ev-03-comm", text: "The presenter spoke clearly about the ramp load sensor project, used the poster well and answered most questions.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-13T15:00:00Z"},
  {id: "ev-03-spelling", text: "A proofread of the ramp load sensor poster found one or two small mistakes.", source: "Poster", location: "Proofread", capturedAt: "2026-05-13T16:00:00Z"},
  {id: "ev-04-shared", text: "The solar charger raised a phone battery from 20% to 45% in three identical runs, using only the parts supplied to the course.", source: "Demonstration", location: "Charging test", capturedAt: "2026-05-14T11:00:00Z"},
  {id: "ev-04-design", text: "The solar charger poster is well laid out and the diagrams support the text, with one crowded panel. Most visitors followed it on their own.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-14T11:00:00Z"},
  {id: "ev-04-value", text: "The team described who needs the solar charger idea, named existing products, and said how a later version could fill a gap.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-14T14:00:00Z"},
  {id: "ev-04-comm", text: "The presenter described the solar charger project adequately and answered most questions, but gave short answers when asked to explain more.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-14T15:00:00Z"},
  {id: "ev-04-spelling", text: "A proofread of the solar charger poster found no spelling or grammar mistakes.", source: "Poster", location: "Proofread", capturedAt: "2026-05-14T16:00:00Z"},
  {id: "ev-05-design", text: "The noise badge poster mixes several fonts and packs text into small blocks. Visitors needed the presenter to explain what the figures showed.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-15T11:00:00Z"},
  {id: "ev-05-physical", text: "The noise badge prototype works as a proof of concept, built from course materials, with exposed wiring.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-15T12:00:00Z"},
  {id: "ev-05-success", text: "The noise badge device met the project goals and gave similar results in three runs.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-15T13:00:00Z"},
  {id: "ev-05-value", text: "The team said why they chose the noise badge project but could not name its users or any existing products.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-15T14:00:00Z"},
  {id: "ev-05-comm", text: "The presenter described the noise badge project adequately and answered most questions, but gave short answers when asked to explain more.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-15T15:00:00Z"},
  {id: "ev-06-design", text: "The plant watering controller poster has a sensible structure, but two panels are crowded and pale text on a light background is hard to read. Visitors asked the presenter to explain the flow.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-16T11:00:00Z"},
  {id: "ev-06-physical", text: "The plant watering controller prototype works and has a neat enclosure, an easy control and one extra feature, a status light.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-16T12:00:00Z"},
  {id: "ev-06-success", text: "The plant watering controller device gave matching results over several runs, and the approach was new to the class.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-16T13:00:00Z"},
  {id: "ev-06-comm", text: "The presenter described the plant watering controller project adequately and answered most questions, but gave short answers when asked to explain more.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-16T15:00:00Z"},
  {id: "ev-06-spelling", text: "A proofread of the plant watering controller poster found several mistakes that a reader would notice.", source: "Poster", location: "Proofread", capturedAt: "2026-05-16T16:00:00Z"},
  {id: "ev-07-shared", text: "While presenting, the team named bike commuters as the audience and compared the light with two existing products.", source: "Presentation", location: "Talk and questions", capturedAt: "2026-05-17T11:00:00Z"},
  {id: "ev-07-design", text: "The bike light poster has a clear reading order, matching colours and large readable figures. A visitor understood the project without the presenter speaking.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-17T11:00:00Z"},
  {id: "ev-07-physical", text: "The bike light prototype works and has a neat enclosure, an easy control and one extra feature, a status light.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-17T12:00:00Z"},
  {id: "ev-07-success", text: "The bike light device met the project goals and gave similar results in three runs.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-17T13:00:00Z"},
  {id: "ev-07-spelling", text: "A proofread of the bike light poster found one or two small mistakes.", source: "Poster", location: "Proofread", capturedAt: "2026-05-17T16:00:00Z"},
  {id: "ev-08-design", text: "The posture wearable poster has a sensible structure, but two panels are crowded and pale text on a light background is hard to read. Visitors asked the presenter to explain the flow.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-18T11:00:00Z"},
  {id: "ev-08-physical", text: "The posture wearable prototype was not finished and could not be shown working.", source: "Demonstration", location: "Prototype table", capturedAt: "2026-05-18T12:00:00Z"},
  {id: "ev-08-success", text: "The posture wearable device did not work during the demonstration, and the team could not say what problem it solved.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-18T13:00:00Z"},
  {id: "ev-08-value", text: "The team said why they chose the posture wearable project but could not name its users or any existing products.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-18T14:00:00Z"},
  {id: "ev-08-comm", text: "The presenter described the posture wearable project adequately and answered most questions, but gave short answers when asked to explain more.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-18T15:00:00Z"},
  {id: "ev-08-spelling", text: "A proofread of the posture wearable poster found one or two small mistakes.", source: "Poster", location: "Proofread", capturedAt: "2026-05-18T16:00:00Z"},
  {id: "ev-09-shared", text: "The dispenser released the right dose at five scheduled times in a row, inside a sealed case with a status screen.", source: "Demonstration", location: "Dispensing test", capturedAt: "2026-05-19T11:00:00Z"},
  {id: "ev-09-design", text: "The pill dispenser poster is well laid out and the diagrams support the text, with one crowded panel. Most visitors followed it on their own.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-19T11:00:00Z"},
  {id: "ev-09-value", text: "The team named the people who would use the pill dispenser idea, explained why current products fall short, and listed next steps for testing and a larger build.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-19T14:00:00Z"},
  {id: "ev-09-comm", text: "The presenter spoke clearly about the pill dispenser project, used the poster well and answered most questions.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-19T15:00:00Z"},
  {id: "ev-09-spelling", text: "A proofread of the pill dispenser poster found no spelling or grammar mistakes.", source: "Poster", location: "Proofread", capturedAt: "2026-05-19T16:00:00Z"},
  {id: "ev-10-design", text: "The recycling sorter poster has no clear order, tiny text and unrelated pictures. Nobody could tell what the project was without being told.", source: "Poster", location: "Whole poster", capturedAt: "2026-05-20T11:00:00Z"},
  {id: "ev-10-success", text: "The recycling sorter device completed most functions, but the team had tested it only once, so the demonstration was partial.", source: "Demonstration", location: "Live test", capturedAt: "2026-05-20T13:00:00Z"},
  {id: "ev-10-value", text: "The team said why they chose the recycling sorter project but could not name its users or any existing products.", source: "Presentation", location: "Motivation panel", capturedAt: "2026-05-20T14:00:00Z"},
  {id: "ev-10-comm", text: "The presenter read the poster aloud for the whole session and could not answer questions about the recycling sorter project.", source: "Q&A", location: "Audience questions", capturedAt: "2026-05-20T15:00:00Z"},
  {id: "ev-10-spelling", text: "A proofread of the recycling sorter poster found mistakes in nearly every section.", source: "Poster", location: "Proofread", capturedAt: "2026-05-20T16:00:00Z"}
] AS row
MERGE (n:Evidence {id: row.id})
SET n.text = row.text, n.source = row.source, n.location = row.location, n.capturedAt = datetime(row.capturedAt);

