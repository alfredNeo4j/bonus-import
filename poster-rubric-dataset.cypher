// Poster Presentation dataset for the Grading Assistant data model.
// All names and projects are fictional. Email addresses use example.com.
// Run it in Query. Every statement uses MERGE on id, so running it twice creates no duplicates.

UNWIND [
  {id: "rub-poster", name: "Poster Presentation Rubric", description: "Rubric for a poster presentation of an engineering prototype, scored on six criteria with five levels each.", totalPoints: 100.0}
] AS row
MERGE (n:Rubric {id: row.id})
SET n.name = row.name, n.description = row.description, n.totalPoints = row.totalPoints;

UNWIND [
  {id: "crit-design", name: "Poster Design", description: "How well the layout, text and graphics communicate the project without narration."},
  {id: "crit-physical", name: "Physical Prototype", description: "The quality and level of detail of the working prototype."},
  {id: "crit-success", name: "Prototype Success", description: "Whether the prototype solves a real problem reliably and with originality."},
  {id: "crit-value", name: "Prototype Value & Potential", description: "The value of the prototype to its audience and its potential for further development."},
  {id: "crit-comm", name: "Communication", description: "How clearly the presenters explain and discuss their work with the audience."},
  {id: "crit-spelling", name: "Spelling and Grammar", description: "The number and effect of spelling and grammar mistakes on the poster."}
] AS row
MERGE (n:Criterion {id: row.id})
SET n.name = row.name, n.description = row.description;

UNWIND [
  {id: "lvl-design-5", label: "Excellent", points: 5, descriptor: "The poster is overall visually appealing - information is well organized, and the text content, graphics, color, font size/selection, and other visual elements work together to communicate a cohesive message. Graphics (e.g. CAD drawings, tables, figures, etc.) are engaging and complement the text. The poster stands alone and can be understood without narration."},
  {id: "lvl-design-4", label: "Great", points: 4, descriptor: "The poster is overall visually appealing - information is well organized, and to a large extent, the text content, graphics, color, font size/selection, and other visual elements work cohesively with one another. Graphics (e.g. CAD drawings, tables, figures, etc.) are engaging and complement the text content. The poster stands alone and can be understood without narration."},
  {id: "lvl-design-3", label: "Good", points: 3, descriptor: "The poster organization and look is adequate, with visual elements working cohesively to some extent, but their placement or design somewhat detract from understanding the poster (for example: they are cluttered, the colors or patterns used make the content difficult to discern). Graphics (e.g. CAD drawings, tables, figures, etc.) complement the text content. The poster cannot stand alone and because of its somewhat lack of organization, requires narration to understand."},
  {id: "lvl-design-2", label: "Fair", points: 2, descriptor: "The poster organization and look is acceptable, but the placement or design of visual elements are distracting from understanding the poster content (for example: they are somewhat cluttered, the colors or patterns used make the content difficult to discern). Some of the graphics (e.g. CAD drawings, tables, figures, etc.) complement the text content to some extent. The poster cannot stand alone and because of its lack of organization, requires narration to understand."},
  {id: "lvl-design-1", label: "Poor", points: 1, descriptor: "The poster is overall visually unappealing - information is poorly organized, and visual elements are used incohesively, making it difficult to follow the poster organization. Graphics (e.g. CAD drawings, tables, figures, etc.) are not used or do not complement the text in any way. The poster cannot stand alone and because of its lack of organization, requires narration to understand."},
  {id: "lvl-physical-5", label: "Excellent", points: 5, descriptor: "Excellent use of materials and resources available to the course to create a functioning, proof-of-concept prototype. Presenter(s) have exceeded expectations by incorporating a high level of detail into their fabrication (i.e. circuitry is housed and invisible to the user, user interface is accessible, etc.) and/or additional elements into their project (i.e. website, additional functionalities as defined by the RAD mentor)."},
  {id: "lvl-physical-4", label: "Great", points: 4, descriptor: "Excellent use of materials and resources available to the course to create a functioning, proof-of-concept prototype. Presenter(s) have exceeded expectations by incorporating some additional level of detail into their fabrication (i.e. circuitry is housed and invisible to the user, user interface is accessible, etc.) and/or additional elements into their project (i.e. website, additional functionalities as defined by the RAD mentor)."},
  {id: "lvl-physical-3", label: "Good", points: 3, descriptor: "Adequate use of materials and resources available to the course to create a functioning, proof-of-concept prototype."},
  {id: "lvl-physical-2", label: "Fair", points: 2, descriptor: "Adequate use of materials and resources available to the course to create a proof-of-concept prototype."},
  {id: "lvl-physical-1", label: "Poor", points: 1, descriptor: "Presenter(s) failed to complete and present working prototype."},
  {id: "lvl-success-5", label: "Excellent", points: 5, descriptor: "Presenter(s) have clearly identified an engineering solution to a real-world problem and demonstrated a feasible solution to the issue. The device's performance is repeatable and reliable. Presenter(s) have exceeded expectations through the originality of their idea or approach to the engineering solution they have identified, as well as completion of tasks (such as extra credit) beyond the expectations of the project."},
  {id: "lvl-success-4", label: "Great", points: 4, descriptor: "Presenter(s) have clearly identified an engineering solution to a real-world problem and demonstrated a feasible solution to the issue. The device's performance is repeatable and reliable. Presenter(s) have exceeded expectations through the originality of their idea or approach to the engineering solution they have identified."},
  {id: "lvl-success-3", label: "Good", points: 3, descriptor: "Presenter(s) have adequately identified an engineering solution to a real-world problem and demonstrated a feasible solution to the issue. The device's performance is overall repeatable and reliable. Presenter(s) have all met expectations for their project."},
  {id: "lvl-success-2", label: "Fair", points: 2, descriptor: "Presenter(s) have adequately identified an engineering solution to a real-world problem and demonstrated a feasible solution to the issue. The device can complete most of its functions, or, if it is completely functional, testing was not robust, resulting in an incomplete demonstration."},
  {id: "lvl-success-1", label: "Poor", points: 1, descriptor: "Presenter(s) have not adequately identified an engineering solution to a real-world problem and demonstrated a feasible solution to the issue. The device does not function as intended or described."},
  {id: "lvl-value-5", label: "Excellent", points: 5, descriptor: "The prototype presents a clear solution to an engineering problem. The presenters have created a unique and effective solution with clear value to its target audience. There is strong potential for further development, and the presenters articulate clear next steps for future directions in testing or fabrication (scaling up, incorporating higher quality materials, making use of institutional resources such as the Prototyping Fund, e-Lab funds, etc)."},
  {id: "lvl-value-4", label: "Great", points: 4, descriptor: "The value of the prototype is clear. The presenters have created a unique, effective solution with clear value to its target audience, and they articulate how the prototype would compare to existing solutions. There is strong potential for further development, and the solution stands out in at least one way compared to existing solutions."},
  {id: "lvl-value-3", label: "Good", points: 3, descriptor: "The value of the prototype is clear. The presenters clearly articulate their motivation for their project, identifying a target audience and existing solutions to the problem. The presenters can describe how their prototype, if further developed, would provide an effective alternative to existing solutions, or fill a gap where solutions may not already exist."},
  {id: "lvl-value-2", label: "Fair", points: 2, descriptor: "The value of the prototype is somewhat clear. The presenters share their motivation for the project, but their understanding of their target audience and existing solutions to the problem is limited."},
  {id: "lvl-value-1", label: "Poor", points: 1, descriptor: "The value of the prototype is unclear. There is unclear motivation for the project. The presenters demonstrate no understanding of the prototype's target audience and/or existing solutions to the problem they have identified."},
  {id: "lvl-comm-5", label: "Excellent", points: 5, descriptor: "Presenter(s) speak clearly and could succinctly and compellingly describe their motivations, methodology, and results. They use the poster as a tool for explanation and guide for their presentation, engaging in conversation with the audience. They answer all questions appropriately and elaborate for clarity if needed. A non-specialist could easily understand their work."},
  {id: "lvl-comm-4", label: "Great", points: 4, descriptor: "Presenter(s) speak clearly and could succinctly describe their motivations, methodology, and results. They use the poster as a tool for explanation and guide for their presentation, engaging in conversation with the audience. They answer most questions appropriately and elaborate for clarity if needed. A non-specialist could easily understand their work."},
  {id: "lvl-comm-3", label: "Good", points: 3, descriptor: "Presenter(s) speak clearly and could adequately describe their motivations, methodology, and results. They use the poster as a tool for explanation and guide for their presentation. They answer most questions appropriately but are somewhat able to elaborate for clarity when needed. A non-specialist could understand their work."},
  {id: "lvl-comm-2", label: "Fair", points: 2, descriptor: "Presenter(s) speak clearly for most of the time, but could not adequately describe all of their motivations, methodology, and results. They are unengaged with the audience for a significant amount of time, reading from the poster rather than discussing the content with the audience. They are somewhat able to answer questions appropriately and unable to elaborate for clarity when needed. A non-specialist could not easily understand their work."},
  {id: "lvl-comm-1", label: "Poor", points: 1, descriptor: "Presenter(s) were unprepared. They do not speak clearly and failed to succinctly describe the context and details of their work. They are unengaged with the audience, reading from the poster the entire time, and they are unable to answer audience questions about their work. Their work is not understandable by the audience."},
  {id: "lvl-spelling-5", label: "Excellent", points: 5, descriptor: "No spelling and grammar mistakes"},
  {id: "lvl-spelling-4", label: "Great", points: 4, descriptor: "Minimal spelling and grammar mistakes"},
  {id: "lvl-spelling-3", label: "Good", points: 3, descriptor: "Noticeable spelling and grammar mistakes"},
  {id: "lvl-spelling-2", label: "Fair", points: 2, descriptor: "Frequent spelling and grammar mistakes, present in almost every section of the poster"},
  {id: "lvl-spelling-1", label: "Poor", points: 1, descriptor: "Excessive spelling and/or grammar mistakes, distracting completely from the content of the poster"}
] AS row
MERGE (n:Level {id: row.id})
SET n.label = row.label, n.points = row.points, n.descriptor = row.descriptor;

UNWIND [
  {id: "stu-01", name: "Amara Osei", email: "amara.osei@example.com"},
